<Window x:Class="SignalRChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SignalRChatClient"
        mc:Ignorable="d"
        Title="SignalR WPF Chat" Height="400" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="UserNameBox"  Width="120" Margin="0,0,10,0" />
            <Button Content="Connect"
        Click="Connect_Click"
        Width="100"
        Height="30"
        Background="#007ACC"
        Foreground="White"/>
        </StackPanel>

        <ListBox x:Name="MessageList" Grid.Row="1"/>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0">
            <TextBox x:Name="MessageTextBox"
         Width="300" Height="30"
         Background="#2D2D30"
         Foreground="White"
         BorderBrush="#007ACC"/>
            <Button Content="Send" Width="80" Click="Send_Click" />
        </StackPanel>
    </Grid>
</Window>
